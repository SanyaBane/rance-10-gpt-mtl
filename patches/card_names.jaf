/*
 * English character names and card labels.
 *
 * Two strings in the カードデータ table look like labels but are save keys:
 * a card's Id addresses its per-card state, and 識別名 is the node name in the
 * 識別名情報 ex-tree under which rank and event flags are stored. Translating
 * either one in the data table detaches the game from its own saved state --
 * every rank reads back as zero while the display still looks correct.
 *
 * So the data table keeps its Japanese, and the two display accessors read an
 * English string out of the ex-tree instead. The raw value is passed as the
 * EX_String default, so a missing or empty entry reproduces the unpatched
 * behaviour exactly: the worst case is a Japanese name, never a crash. That
 * also lets this file be built and tested independently of the data.
 *
 * See docs/card-name-localization.md for the full write-up.
 */

/*
 * The English label for one card Id, where the tree has one.
 *
 * Three places want this exact lookup -- the card plate below, and the two
 * card Ids the enemy status panel draws -- so it is a function rather than an
 * expression written out three times. patches/enemy_panel_cards.jam calls it
 * by name, and alice-tools resolves a .jam's CALLFUNC against what it has
 * already read, so this file has to be handed to it before that .jam.
 * scripts/ain.js passes them in that order.
 *
 * The Id itself is the default, so a card the tree does not name -- the
 * ＜エール＞ cards carry no entry -- renders exactly as it did unpatched.
 */
string CardEnglishLabel(string id)
{
	return EX_String("識別名情報.カード英名." + id + ".英名", id, 0);
}

/*
 * Name shown in the combat log. super() returns 識別名, except for the chapter
 * 2 protagonist where the original getter substitutes the player-chosen name.
 * Wrapping the original instead of reimplementing it keeps that branch intact.
 *
 * The full name is the right register here -- it comes from カード情報's
 * フルネーム, which the translation already provides in English.
 */
override string Character@Name::get(void)
{
	string name = super();
	return EX_String("識別名情報." + name + ".英名", name, 0);
}

/*
 * Label drawn on the card plate. super() returns the card Id, or the
 * player-chosen name for the ＜エール＞ cards. Those are absent from カード英名
 * and fall through to the default, which is what the original returned.
 *
 * Patching the accessor covers all five render sites at once:
 * CardConstructProcessCacheFront@CreateName, CardConstructorFrontCard::Create
 * (twice) and the two back-face constructors.
 *
 * The label needs the *short* name plus a translated affix, not the full name:
 * the plate clips text centred without scaling it, so "Naked Crook Mofus"
 * would lose both its head and its tail.
 */
override string PlayerCard@ViewName::get(void)
{
	return CardEnglishLabel(super());
}

/*
 * The name in the battle result screen's first-kill caption -- s[3942]
 * "First Finisher by %s". Nothing else calls this getter.
 *
 * It is a different class from PlayerCard@ViewName above and shares nothing
 * with it but the property name, which is exactly how this got missed: patching
 * the card plate and the combat log left the result screen printing 識別名 raw,
 * so an English caption ended in a Japanese name. The getter is
 * Character@Name::get written out a second time -- CharacterId, with the
 * chapter 2 protagonist's player-chosen name substituted -- and the override
 * has to be written out a second time with it.
 *
 * The *short* name, not the full one Character@Name uses. The caption spends
 * "First Finisher by " before the name is even reached, and its part is 410
 * pixels wide before the "+" sits on top of it (Caption at x=80, Sign at x=490
 * in Game/Battle/Result/BattleResultValueView.pactex.x). Nothing clips, so an
 * overlong name runs out over the bonus figure rather than being cut; the short
 * name is a median 1.43x the Japanese it replaces where the full name is 1.68x
 * and reaches 3.12x. Some still overrun, and the game's own longest Japanese
 * captions overrun the same budget, so this is the register the layout was
 * drawn for rather than a fit.
 *
 * super() is the raw id and is passed as the default, so anything 短縮英名 does
 * not name renders exactly as it did unpatched. That covers the chapter 2
 * protagonist, whose id is not an id at all by the time it arrives.
 */
override string BattleBonus@ViewName::get(void)
{
	string id = super();
	return EX_String("識別名情報.短縮英名." + id + ".英名", id, 0);
}
